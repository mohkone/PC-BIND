* text=auto
*.py text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cff text eol=lf
*.svg text eol=lf
*.png binary

# Preserve the exact bytes of hash-bound experiment records and source archives.
research_review/matched_fold1_v1/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
research_review/frozen_5fold_dev_v1/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
research_review/multiseed_dev_v1/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
# Empty unified-diff context lines contain a required space prefix.
research_review/multiseed_dev_v1/implementation_validation_v2/trainer_delta.patch -whitespace
